{
  "name": "react-crash-guard",
  "version": "1.1.2",
  "private": false,
  "description": "React error boundary library that also catches async errors — global, route, and feature-level isolation with pluggable Sentry, CloudWatch, and custom reporting.",
  "author": "Muhammad Zia <mughalheree@gmail.com>",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "dev": "pnpm --filter demo run dev",
    "dev:demo": "pnpm --filter demo run dev",
    "dev:example-01": "pnpm --filter 01-basic-boundary run dev",
    "dev:example-02": "pnpm --filter 02-global-app-boundary run dev",
    "dev:example-03": "pnpm --filter 03-sentry-integration run dev",
    "dev:example-04": "pnpm --filter 04-cloudwatch-integration run dev"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.14.2"
}
